<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MemberCard.Pages.LoginPage"
             Title="Login"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackgroundColor}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Fallback kalau belum ada di App.xaml -->
            <Color x:Key="PageBg">#F6F7FB</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#1F2937</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>
            <Color x:Key="BorderSoft">#E5E7EB</Color>

            <Style x:Key="TitleLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
            </Style>

            <Style x:Key="SubLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
            </Style>

            <Style x:Key="InputStyle" TargetType="Entry">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="PlaceholderColor" Value="#9CA3AF"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="ClearButtonVisibility" Value="WhileEditing"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="HeightRequest" Value="52"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}"/>
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryColor}"/>
            </Style>

            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{StaticResource SecondaryColor}"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Root layout -->
    <Grid RowDefinitions="Auto,*,Auto"
          Padding="24"
          BackgroundColor="{StaticResource PageBg}">

        <!-- Header (logo + brand text) -->
        <Grid Grid.Row="0" Padding="0,8,0,14">
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Image Source="logo.png" HeightRequest="88" HorizontalOptions="Center"/>

                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="Masuk"
                           Style="{StaticResource TitleLabelStyle}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Gunakan OTP yang dikirim ke email Anda"
                           Style="{StaticResource SubLabelStyle}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- Main card -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14">

                <Border BackgroundColor="{StaticResource CardBg}"
                        Stroke="{StaticResource BorderSoft}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="14">

                        <!-- Email field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email" Style="{StaticResource SubLabelStyle}"/>
                            <Border Stroke="{StaticResource BorderSoft}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14,10">
                                <Entry x:Name="EmailEntry"
                                       Style="{StaticResource InputStyle}"
                                       Placeholder="contoh: budi@email.com"
                                       Keyboard="Email"
                                       TextChanged="OnEmailChanged"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- OTP + Send button -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Kode OTP" Style="{StaticResource SubLabelStyle}"/>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">

                                <Border Grid.Column="0"
                                        Stroke="{StaticResource BorderSoft}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14,10">
                                    <Entry x:Name="OtpEntry"
                                           Style="{StaticResource InputStyle}"
                                           Placeholder="6 digit"
                                           Keyboard="Numeric"
                                           MaxLength="6"/>
                                </Border>

                                <Button x:Name="SendOtpButton"
                                        Grid.Column="1"
                                        Text="Kirim Kode"
                                        HeightRequest="44"
                                        Padding="16,0"
                                        CornerRadius="14"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        BackgroundColor="#111827"
                                        TextColor="White"
                                        Clicked="OnSendOtpClicked"/>
                            </Grid>

                            <!-- Hint / status -->
                            <Border x:Name="OtpHintBox"
                                    IsVisible="False"
                                    BackgroundColor="#F3F4F6"
                                    Stroke="{StaticResource BorderSoft}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10">
                                <Label x:Name="OtpHintLabel"
                                       Text=""
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Verify button (hidden until OTP sent) -->
                        <Button x:Name="VerifyButton"
                                Text="Verifikasi Dan Masuk"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsVisible="False"
                                Clicked="OnVerifyClicked"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Alternative actions -->
                <Border BackgroundColor="{StaticResource CardBg}"
                        Stroke="{StaticResource BorderSoft}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Opsi lain"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>

                        <Button Text="Masuk dengan Kartu Member"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Clicked="OnLoginWithCard"/>

                        <Button Text="Daftar Member Baru"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnRegisterClicked"/>

                        <Button Text="Skip (Demo)"
                                Style="{StaticResource GhostButtonStyle}"
                                Clicked="OnSkip"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer -->
        <StackLayout Grid.Row="2" Spacing="2" Padding="0,10"
                     HorizontalOptions="Center" VerticalOptions="End">
            <Label x:Name="VersionText" FontSize="12" Opacity="0.7"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource TextSecondary}"/>

            <Label Text="Designed By Affari Retail System"
                   FontSize="12"
                   Opacity="0.8"
                   TextDecorations="Underline"
                   TextColor="{StaticResource SecondaryColor}"
                   HorizontalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDesignerTapped"/>
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>

    </Grid>
</ContentPage>
